{
  "name": "@oliveryasuna/ink-frame",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://github.com/oliveryasuna/ink-frame",
  "author": "Oliver Yasuna",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliveryasuna/ink-frame.git"
  },
  "bugs": "https://github.com/oliveryasuna/ink-frame/issues",
  "keywords": [
    "ascii",
    "border",
    "box",
    "box-drawing",
    "cli",
    "console",
    "grid",
    "ink",
    "layout",
    "panes",
    "react",
    "split",
    "terminal",
    "tui"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "check:bun": "bun run ./check-bun-version.ts",
    "format:pkg": "syncpack format",
    "lint": "eslint",
    "prepack": "bun run build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "figures": "6.1.0"
  },
  "devDependencies": {
    "@oliveryasuna/eslint-config": "2.2.2",
    "@oliveryasuna/tsdown-config": "1.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "1.3.14",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/react": "19.2.18",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.1.0",
    "react": "19.2.8",
    "secretlint": "13.0.2",
    "syncpack": "15.3.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "ink": ">=5",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
